<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BalkanMod</AssemblyName>
    <RootNamespace>BalkanMod</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Spielversion, gegen die gebaut wird -->
    <GameVersion>1.5.7.125802</GameVersion>
    <ModuleId>BalkanMod</ModuleId>
    <ModuleDir>$(MSBuildThisFileDirectory)..\..\Module\$(ModuleId)\</ModuleDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(ModuleDir)bin\Win64_Shipping_Client\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nur Metadaten der Spiel-DLLs (BUTR, MIT-Lizenz), damit auch ohne installiertes Spiel gebaut werden kann -->
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="$(GameVersion)" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- MCM-Einstellungen: MCMv5.dll liefert das Modul "Mod Configuration Menu v5" (Bannerlord.MBOptionScreen) mit -->
    <PackageReference Include="Bannerlord.MCM" Version="5.13.1" PrivateAssets="all" IncludeAssets="compile" />
    <!-- Harmony und UIExtenderEx: die DLLs liefern die Module Bannerlord.Harmony und Bannerlord.UIExtenderEx mit -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="Bannerlord.UIExtenderEx" Version="3.0.3" PrivateAssets="all" IncludeAssets="compile" />
  </ItemGroup>

  <!--
    Das Modding Kit (Editor) lädt die DLL aus bin\Win64_Shipping_wEditor statt aus bin\Win64_Shipping_Client.
    Darum kommt die gebaute DLL in beide Ordner.
  -->
  <Target Name="CopyToEditorBin" AfterTargets="Build">
    <ItemGroup>
      <ClientBinFiles Include="$(ModuleDir)bin\Win64_Shipping_Client\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientBinFiles)" DestinationFolder="$(ModuleDir)bin\Win64_Shipping_wEditor\" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Optional: Wenn GameFolder gesetzt ist (z. B. dotnet build -p:GameFolder="C:\Program Files (x86)\Steam\steamapps\common\Mount & Blade II Bannerlord"),
    wird der ganze Modulordner nach dem Build in den Modules-Ordner des Spiels kopiert.
  -->
  <Target Name="CopyModuleToGame" AfterTargets="Build" Condition="'$(GameFolder)' != ''">
    <ItemGroup>
      <ModuleFiles Include="$(ModuleDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleFiles)" DestinationFiles="@(ModuleFiles->'$(GameFolder)\Modules\$(ModuleId)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
