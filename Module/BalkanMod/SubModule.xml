<?xml version="1.0" encoding="utf-8"?>
<Module>
  <Id value="BalkanMod"/>
  <Name value="Balkan 1700"/>
  <Version value="v0.0.1"/>
  <DefaultModule value="false"/>
  <ModuleCategory value="Singleplayer"/>
  <ModuleType value="Community"/>
  <DependedModules>
    <DependedModule Id="Native" DependentVersion="v1.5.7" Optional="false"/>
    <DependedModule Id="SandBoxCore" DependentVersion="v1.5.7" Optional="false"/>
    <DependedModule Id="Sandbox" DependentVersion="v1.5.7" Optional="false"/>
    <!-- War Sails: optional, aber wenn vorhanden, laden wir danach, damit unsere Kultur-Patches zuletzt greifen -->
    <DependedModule Id="NavalDLC" DependentVersion="v1.3.7" Optional="true"/>
  </DependedModules>
  <SubModules>
    <SubModule>
      <Name value="BalkanMod"/>
      <DLLName value="BalkanMod.dll"/>
      <SubModuleClassType value="BalkanMod.SubModule"/>
      <Tags/>
    </SubModule>
  </SubModules>
  <Xmls>
    <!-- Erzeugt von tools/gen_content.py aus data/kulturen/ -->
    <XmlNode>
      <XmlName id="NPCCharacters" path="balkan_troops"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
        <GameType value="CustomGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="partyTemplates" path="balkan_party_templates"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
      </IncludedGameTypes>
    </XmlNode>
    <!-- XSLT-Patch: ändert Vlandia und Aserai, fügt Venedig und Ragusa hinzu (Muster wie im NavalDLC) -->
    <XmlNode>
      <XmlName id="SPCultures" path="XSLT/BalkanMod_SandBoxCore_SPCultures"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
        <GameType value="CustomGame"/>
      </IncludedGameTypes>
    </XmlNode>
  </Xmls>
</Module>
