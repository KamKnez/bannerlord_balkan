<?xml version="1.0" encoding="utf-8"?>
<Module>
  <Id value="BalkanMod"/>
  <Name value="Balkan 1700"/>
  <Version value="v0.1.0"/>
  <DefaultModule value="false"/>
  <ModuleCategory value="Singleplayer"/>
  <ModuleType value="Community"/>
  <DependedModules>
    <!-- BUTR-Standardmods, getrennt zu installieren (Steam-Workshop oder Nexus) -->
    <DependedModule Id="Bannerlord.Harmony" DependentVersion="v2.4.2" Optional="false"/>
    <DependedModule Id="Bannerlord.ButterLib" DependentVersion="v2.12.0" Optional="false"/>
    <DependedModule Id="Bannerlord.UIExtenderEx" DependentVersion="v3.0.3" Optional="false"/>
    <DependedModule Id="Bannerlord.MBOptionScreen" DependentVersion="v5.13.1" Optional="false"/>
    <DependedModule Id="Native" DependentVersion="v1.5.7" Optional="false"/>
    <DependedModule Id="SandBoxCore" DependentVersion="v1.5.7" Optional="false"/>
    <DependedModule Id="Sandbox" DependentVersion="v1.5.7" Optional="false"/>
    <!-- War Sails: optional, aber wenn vorhanden, laden wir danach, damit unsere Kultur-Patches zuletzt greifen -->
    <DependedModule Id="NavalDLC" DependentVersion="v1.3.7" Optional="true"/>
  </DependedModules>
  <SubModules>
    <SubModule>
      <Name value="BalkanMod"/>
      <DLLName value="BalkanMod.dll"/>
      <SubModuleClassType value="BalkanMod.SubModule"/>
      <Tags/>
    </SubModule>
  </SubModules>
  <Xmls>
    <!-- Erzeugt von tools/gen_content.py aus data/kulturen/ -->
    <XmlNode>
      <XmlName id="Items" path="balkan_items"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
        <GameType value="CustomGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="NPCCharacters" path="balkan_troops"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
        <GameType value="CustomGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="partyTemplates" path="balkan_party_templates"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
      </IncludedGameTypes>
    </XmlNode>
    <!-- XSLT-Patch: ändert Vlandia und Aserai, fügt Venedig und Ragusa hinzu (Muster wie im NavalDLC) -->
    <XmlNode>
      <XmlName id="SPCultures" path="XSLT/BalkanMod_SandBoxCore_SPCultures"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
        <GameType value="CustomGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <!-- XSLT-Patch: Ausrüstungsvorlagen für die neuen Kulturen (ohne sie stürzt der Kampagnenstart ab) -->
    <XmlNode>
      <XmlName id="EquipmentRosters" path="XSLT/BalkanMod_SandBoxCore_EquipmentRosters"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
        <GameType value="CustomGame"/>
      </IncludedGameTypes>
    </XmlNode>
    <!-- XSLT-Patches aus data/reiche/: Reiche, Clans, Lords, Helden und Kultur der Siedlungen -->
    <XmlNode>
      <XmlName id="Kingdoms" path="XSLT/BalkanMod_Sandbox_Kingdoms"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="Factions" path="XSLT/BalkanMod_Sandbox_Factions"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="NPCCharacters" path="XSLT/BalkanMod_Sandbox_Lords"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="Heroes" path="XSLT/BalkanMod_Sandbox_Heroes"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
      </IncludedGameTypes>
    </XmlNode>
    <XmlNode>
      <XmlName id="Settlements" path="XSLT/BalkanMod_Sandbox_Settlements"/>
      <IncludedGameTypes>
        <GameType value="Campaign"/>
        <GameType value="CampaignStoryMode"/>
      </IncludedGameTypes>
    </XmlNode>
  </Xmls>
</Module>
