<?xml version="1.0" encoding="utf-8"?>
<!-- Engine-Daten des Moduls: Ohne diese Datei lädt das Spiel action_types.xml usw. nicht (ASSERT
     "get_action_code_index failed for act_austria_..."). Aufbau wie in Napoleonic Warfare. -->
<base xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" type="solution">
	<file id="soln_action_types" name="ModuleData/action_types.xml" type="action_type"/>
	<file id="soln_action_sets" name="ModuleData/action_sets.xml" type="action_set"/>
	<file id="soln_item_usage_sets" name="ModuleData/item_usage_sets.xml" type="item_usage_set"/>
	<file id="soln_movement_sets" name="ModuleData/movement_sets.xml" type="movement_set"/>
	<file id="soln_full_movement_sets" name="ModuleData/full_movement_sets.xml" type="full_movement_set"/>
	<!-- Klänge: Das Spiel liest module_sounds.xml auch von selbst, der Editor nur über diesen Eintrag. Ohne ihn fehlen
	     dort die Klangnamen der Animationen ("Sound not found: austria_musket_reload_phase2"). -->
	<file id="soln_module_sound" name="ModuleData/module_sounds.xml" type="module_sound"/>
</base>
